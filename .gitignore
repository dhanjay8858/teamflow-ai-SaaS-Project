# =============================================================================
# TeamFlow AI — Root Git Ignore Configuration
# =============================================================================

# ── Environment & Secret Files (CRITICAL: Never commit credentials) ─────────
.env
.env.*
!.env.example
!.env.production.example
server/.env
server/.env.*
!server/.env.example
!server/.env.production.example
client/.env
client/.env.*
!client/.env.example
!client/.env.production.example

# ── Node.js Dependencies & Packages ─────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json.bak

# ── Production Build & Compiled Artifacts ────────────────────────────────────
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# ── Test & Coverage Reports ──────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
.tempmediaStorage/

# ── Logs & Temporary Execution Files ─────────────────────────────────────────
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE & Editor Specific Files ──────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ── Operating System Junk Files ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
