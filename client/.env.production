# Production environment variables for TeamFlow AI frontend
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# Replace placeholders with your actual values

# Backend API URL (your Render service URL)
VITE_API_BASE_URL=https://YOUR_RENDER_APP.onrender.com/api/v1

# Backend WebSocket URL (same as your Render service URL, no path)
VITE_SOCKET_URL=https://YOUR_RENDER_APP.onrender.com
