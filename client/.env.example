# TeamFlow AI — Frontend Environment Variables
# Copy this file to .env.local for local development

# Backend API URL
# Local: leave as-is (Vite dev proxy handles /api routing)
# Production: Set in Vercel Dashboard or .env.production
VITE_API_BASE_URL=/api/v1

# Backend WebSocket URL
# Local: point to local backend server
# Production: Set to your Render backend URL (e.g., https://teamflow.onrender.com)
VITE_SOCKET_URL=http://localhost:5000
