# ==========================================
# TEAMFLOW AI — PLATFORM ENVIRONMENT CONFIG
# ==========================================

# Core Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/teamflow

# Authentication Secrets (Replace with random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (File Uploads & Attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (Optional / Horizontal Scaling)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Metrics & Logging
METRICS_ENABLED=true
LOG_LEVEL=info
APP_VERSION=1.0.0
ENABLE_REDIS_EVENTS=false

# ==========================================
# 🤖 AI PLATFORM CONFIGURATION
# ==========================================

# Primary LLM Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# First Cloud Fallback: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Fallback LLM & Nomic Embeddings: Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5

# Provider Defaults & RAG Setup
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=nomic
VECTOR_STORE=mongodb

# Hyperparameters & Timeouts
LLM_TIMEOUT_MS=15000
MAX_RETRIES=2
MAX_CONTEXT_TOKENS=128000
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.95

