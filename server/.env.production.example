# =============================================================================
# TeamFlow AI — Production Backend Environment Configuration Template
# =============================================================================
# Copy or reference these keys when setting up environment variables in Render
# (Dashboard -> Service -> Settings -> Environment Variables)
# =============================================================================

# Core Server Configuration
NODE_ENV=production
PORT=10000
CLIENT_URL=https://your-app.vercel.app
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/teamflow_prod?retryWrites=true&w=majority

# Authentication Secrets (Use strong 64-char random hex strings)
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32_access_secret_key_here
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (File Uploads & Attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration (Optional for Horizontal Scaling)
REDIS_ENABLED=false
REDIS_URL=rediss://default:password@your-upstash-redis.upstash.io:6379

# Metrics & Observability
METRICS_ENABLED=true
LOG_LEVEL=info
APP_VERSION=1.2.0

# AI Platform Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

LLM_PROVIDER=groq
EMBEDDING_PROVIDER=nomic
VECTOR_STORE=mongodb

# Hyperparameters
LLM_TIMEOUT_MS=15000
MAX_RETRIES=2
MAX_CONTEXT_TOKENS=128000
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0.7
TOP_P=0.95
